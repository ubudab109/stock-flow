NODE_ENV=development
PORT=3000

# DB Configuration
DATABASE_URL=postgresql://stockflow:stockflow@localhost:55432/stockflow?schema=public

# Used to sign session JWTs. Generate a real secret for anything beyond local dev,
# e.g. `openssl rand -base64 48`.
JWT_SECRET=dev-only-change-me
JWT_EXPIRES_IN=7d

# Basis points, e.g. 1100 = 11%. Applied to the invoice subtotal.
TAX_RATE_BPS=1100

# Origin allowed to make credentialed (cookie) requests to this API.
WEB_ORIGIN=http://localhost:5173
