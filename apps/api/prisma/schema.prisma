generator client {
  provider               = "prisma-client"
  output                 = "../src/generated/prisma"
  runtime                = "nodejs"
  moduleFormat           = "esm"
  generatedFileExtension = "ts"
  importFileExtension    = "js"
}

datasource db {
  provider = "postgresql"
}

/// A staff member. Each user is their own isolated workspace: they only ever
/// see products/invoices they created.
model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  sessions        Session[]
  products        Product[]
  invoices        Invoice[]
  invoiceCounters InvoiceCounter[]

  @@map("users")
}

/// A revocable server-side record backing a signed JWT (the JWT's `sid` claim
/// is this row's id). Deleting the row is what makes logout actually work,
/// instead of relying on the client to "forget" a stateless token.
model Session {
  id        String   @id @default(uuid())
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model Product {
  id             String   @id @default(uuid())
  userId         String
  sku            String
  name           String
  description    String?
  /// Minor currency units (e.g. cents). Never a float.
  unitPrice      Int
  quantityOnHand Int
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  invoiceItems InvoiceItem[]

  @@unique([userId, sku])
  @@index([userId, name])
  @@map("products")
}

enum InvoiceStatus {
  DRAFT
  ISSUED
  PAID
  CANCELLED
}

model Invoice {
  id            String        @id @default(uuid())
  userId        String
  invoiceNumber String
  customerName  String
  issueDate     DateTime
  dueDate       DateTime?
  status        InvoiceStatus @default(DRAFT)
  notes         String?
  /// Minor currency units, always server-computed from line items — never
  /// trusted from the client.
  subtotal      Int
  taxAmount     Int
  total         Int
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  user  User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  items InvoiceItem[]

  @@unique([userId, invoiceNumber])
  @@index([userId, status])
  @@map("invoices")
}

model InvoiceItem {
  id        String  @id @default(uuid())
  invoiceId String
  productId String
  /// Snapshotted at the moment the line was added — later changes to the
  /// product must never alter an existing invoice.
  productName String
  unitPrice   Int
  quantity    Int
  lineTotal   Int

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([invoiceId])
  @@index([productId])
  @@map("invoice_items")
}

/// Backs atomic, race-free generation of per-user, per-year invoice numbers
/// (INV-{year}-{seq}) via a single INSERT ... ON CONFLICT ... RETURNING.
model InvoiceCounter {
  userId     String
  year       Int
  lastNumber Int    @default(0)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, year])
  @@map("invoice_counters")
}
