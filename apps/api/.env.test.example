# Copy to .env.test. Used only by `pnpm test:e2e` (see prisma/setup-test-db.ts
# and test/setup-env.ts) — a separate database so tests never touch dev data.
# Same Postgres server/credentials as apps/api/.env.example, different dbname.

NODE_ENV=test
DATABASE_URL=postgresql://stockflow:stockflow@localhost:55432/stockflow_test?schema=public
JWT_SECRET=test-only-secret-change-me
JWT_EXPIRES_IN=1h
TAX_RATE_BPS=1100
WEB_ORIGIN=http://localhost:5173
