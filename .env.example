# Used by docker-compose.yml to provision the local Postgres container.
POSTGRES_USER=stockflow
POSTGRES_PASSWORD=stockflow
POSTGRES_DB=stockflow
# Not 5432/5433: this machine already has native Postgres services bound to
# both of those. 55432 is confirmed free — check with `netstat -ano` (Windows)
# or `lsof -i` (macOS/Linux) if you need to change it.
POSTGRES_PORT=55432
