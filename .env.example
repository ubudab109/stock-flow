# One env file for the whole project — Postgres (docker-compose), the API,
# and the web app all read from this same root .env. Copy to .env and adjust.

# ---- Postgres (docker-compose.yml) ----
POSTGRES_USER=stockflow
POSTGRES_PASSWORD=stockflow
POSTGRES_DB=stockflow
# Not 5432/5433: this machine already has native Postgres services bound to
# both of those. 55432 is confirmed free — check with `netstat -ano` (Windows)
# or `lsof -i` (macOS/Linux) if you need to change it.
POSTGRES_PORT=55432

# ---- API (apps/api) ----
NODE_ENV=development
PORT=3000
# Must match the Postgres settings above.
DATABASE_URL=postgresql://stockflow:stockflow@localhost:55432/stockflow?schema=public
# Used to sign session JWTs. Generate a real secret for anything beyond local
# dev, e.g. `openssl rand -base64 48`.
JWT_SECRET=dev-only-change-me
JWT_EXPIRES_IN=7d
# Basis points, e.g. 1100 = 11%. Applied to the invoice subtotal.
TAX_RATE_BPS=1100
# Origin allowed to make credentialed (cookie) requests to the API.
WEB_ORIGIN=http://localhost:5173

# ---- Web (apps/web) ----
VITE_API_URL=http://localhost:3000
